# Copy to .env and fill in real values. Never commit .env.

# --- LLM provider: one key only (LLM_API_KEY) ---
# OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-key-here

# ...or OpenCode Zen (separate free pool, OpenAI-compatible):
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_API_KEY=your-zen-key-here
# Optional model override (comma-separated):
# LLM_MODELS=nemotron-3-ultra-free,deepseek-v4-flash-free,mimo-v2.5-free

DATABASE_URL=postgresql://user:password@host:5432/verireview
